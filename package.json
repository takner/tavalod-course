{
  "name": "tavalod",
  "version": "0.2.0",
  "private": true,
  "description": "Persian RTL PWA for groups of friends: plan birthdays and trips, split, explain and settle money (teaching project).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/takner/tavalod-course.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "e2e": "playwright test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "5.3.0",
    "date-fns-jalali": "4.4.0-0",
    "drizzle-orm": "0.45.3",
    "idb": "8.0.3",
    "next": "16.4.1",
    "nodemailer": "10.0.13",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fast-check": "4.10.2",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
