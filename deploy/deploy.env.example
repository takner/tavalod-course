# Copy to deploy/deploy.env (git-ignored) and fill in your own server. Used by deploy/deploy.sh on
# your machine; the values are passed to the server and recorded in each release's release.env.

# SSH target (key-based login recommended)
TAVALOD_SERVER=deploy@your-server.example
# Where releases, secrets (shared/*.env), backups and logs live on the server
TAVALOD_BASE=/home/deploy/apps/tavalod
# Public domain; its DNS A record must point at the server
TAVALOD_DOMAIN=tavalod.example.com

# Existing Traefik reverse proxy on the server (read these from its real configuration)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
