# Copy to .env.local for development. Never commit real values.

# Postgres connection string
DATABASE_URL=postgres://tavalod:tavalod@127.0.0.1:5433/tavalod
# Integration tests use a separate database (it is wiped by the test run)
TEST_DATABASE_URL=postgres://tavalod:tavalod@127.0.0.1:5433/tavalod_test

# Public base URL — every link in emails is built from this
APP_URL=http://localhost:3000

# Release identifier reported by /api/health (set by the deploy script)
APP_RELEASE=dev

# Email delivery: "smtp" (required in production) or "console" / "outbox" (development only)
EMAIL_TRANSPORT=console
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Tavalod <no-reply@example.com>"
